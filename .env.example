# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Newsletter Cron / Dispatch Authorization Token (Keep secret!)
CRON_SECRET=your_random_secret_token_here

# Newsletter Studio Author Access Key (Separate from Cron Secret)
STUDIO_SECRET=your_long_studio_secret_token_here

# Resend API Key & Sender Email
RESEND_API_KEY=re_123456789
EMAIL_FROM="Gourab Mondal <onboarding@resend.dev>"

# Site Base URL (used for unsubscribe link generation)
NEXT_PUBLIC_SITE_URL=https://gourabmondal.vercel.app

# Optional Contact Form SMTP (already configured)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
