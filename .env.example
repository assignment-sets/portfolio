# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Newsletter Cron / Dispatch Authorization Token (Keep secret!)
CRON_SECRET=your_random_secret_token_here

# Newsletter Studio Author Access Key (Separate from Cron Secret)
STUDIO_SECRET=your_long_studio_secret_token_here

# Newsletter Gmail SMTP (free, 500/day — no domain verification needed for ≤50 subs)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-8LVL1N08S6

# Site Base URL (used for unsubscribe link generation)
NEXT_PUBLIC_SITE_URL=https://gourabmondal.vercel.app

# Site contact form reuses same Gmail SMTP credentials above
